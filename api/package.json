{
  "name": "ecommerce-api",
  "version": "1.0.0",
  "description": "E-commerce REST API with Express and MySQL",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:check": "node scripts/checkSchema.js",
    "db:migrate": "node scripts/checkSchema.js --apply",
    "test": "node --experimental-vm-modules --test"
  },
  "keywords": [
    "express",
    "mysql",
    "api",
    "ecommerce"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-validator": "^7.0.1",
    "fast-xml-parser": "^5.3.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.16.0",
    "nodemailer": "^7.0.12",
    "react-helmet-async": "^3.0.0",
    "soap": "^1.6.4",
    "stripe": "^20.1.0"
  }
}
